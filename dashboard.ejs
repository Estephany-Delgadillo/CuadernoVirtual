<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuaderno Virtual</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-book-open me-2"></i>Cuaderno Virtual</a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/temas/dashboard">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/auth/logout">Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container mt-5 text-center">
        <h1 class="mb-4">¡Hola, <%= nombre %>! </h1>
        <p class="lead mb-5">¿Qué te gustaría hacer hoy?</p>

        <a href="/temas/estudiar" class="boton-opcion boton-estudiar">
            <i class="fas fa-graduation-cap icono"></i>
            Estudiar un tema
        </a>

        <a href="/temas/agregar" class="boton-opcion boton-agregar">
            <i class="fas fa-plus-circle icono"></i>
            Agregar un nuevo tema
        </a>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>