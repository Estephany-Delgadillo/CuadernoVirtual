<!-- Vista para listar temas -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estudiar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-book-open me-2"></i>Cuaderno Virtual</a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/temas/dashboard">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/auth/logout">Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-book me-2"></i>Mis Temas de Estudio</h2>
            <a href="/temas/agregar" class="btn btn-rosa">+ Nuevo Tema</a>
        </div>

        <% if (temas.length === 0) { %>
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4>No tienes temas aún</h4>
                <p>¡Comienza agregando tu primer tema de estudio!</p>
                <a href="/temas/agregar" class="btn btn-lila">Agregar Tema</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <% temas.forEach(tema => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="mb-0"><%= tema.titulo %></h5>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <% if (tema.notas) { %>
                                    <p class="text-muted small"><%= tema.notas.substring(0, 100) %>...</p>
                                <% } %>
                                <div class="mt-auto">
                                    <small class="d-block mb-2">
                                        ⏱️ <strong><%= tema.tiempo_estudio %></strong> minutos estudiados
                                    </small>
                                    <% if (tema.archivo) { %>
                                        <small class="d-block text-success">
                                            📎 Archivo adjunto
                                        </small>
                                    <% } %>
                                    <a href="/temas/ver/<%= tema.id %>" class="btn btn-lila w-100 mt-3">Abrir Tema</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>