<!-- Formulario para agregar tema -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Tema</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-book-open me-2"></i>Cuaderno Virtual</a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/temas/dashboard">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="/auth/logout">Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-white">
                        <h4 class="text-center mb-0"><i class="fas fa-plus-circle me-2"></i>Agregar Nuevo Tema</h4>
                    </div>
                    <div class="card-body">
                        <% if (error) { %>
                            <div class="alert alert-danger"><%= error %></div>
                        <% } %>
                        <form method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label for="titulo" class="form-label">Título del tema *</label>
                                <input type="text" name="titulo" id="titulo" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="notas" class="form-label">Tus notas (opcional)</label>
                                <textarea name="notas" id="notas" class="form-control" rows="4" placeholder="Escribe aquí lo que quieras recordar..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="tiempo_estudio" class="form-label">Tiempo que has estudiado (en minutos)</label>
                                <input type="number" name="tiempo_estudio" id="tiempo_estudio" class="form-control" min="0" value="0">
                            </div>
                            <div class="mb-3">
                                <label for="archivo" class="form-label">Adjuntar archivo (PDF, JPG, PNG, TXT)</label>
                                <input type="file" name="archivo" id="archivo" class="form-control">
                                <div class="form-text">Máximo 5MB. Archivos seguros y privados.</div>
                            </div>
                            <button type="submit" class="btn btn-rosa w-100">Guardar Tema</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>