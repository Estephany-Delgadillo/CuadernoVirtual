<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= tema.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .pizarra {
            min-height: 200px;
            border: 2px dashed #b388eb;
            border-radius: 12px;
            padding: 15px;
            background-color: #fef9ff;
            font-family: 'Poppins', monospace;
            font-size: 1.1rem;
            resize: vertical;
        }
        .contador {
            font-size: 1.8rem;
            font-weight: 700;
            color: #b388eb;
            background: white;
            padding: 10px 20px;
            border-radius: 50px;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(179, 136, 235, 0.3);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-book-open me-2"></i>Cuaderno Virtual</a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <button id="btn-guardar" class="btn btn-lila me-2">
                        <i class="fas fa-save me-1"></i>Guardar Progreso
                    </button>
                </li>
                <li class="nav-item">
                    <a href="/temas/estudiar" class="btn btn-outline-light">Volver</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container mt-4">
        <div class="card">
            <div class="card-header bg-white text-center">
                <h2 class="mb-2"><%= tema.titulo %></h2>
                <div class="contador" id="contador">00:00</div>
                <p class="mt-2 text-muted"> Tiempo estudiado: <strong><%= tema.tiempo_estudio %> min</strong></p>
            </div>
            <div class="card-body">
                <!-- Pizarra -->
                <div class="mb-4">
                    <h5><i class="fas fa-edit me-2"></i>Pizarra de estudio</h5>
                    <p class="text-muted small">Escribe aquí tus ideas, resúmenes o dudas. ¡No se guarda automáticamente!</p>
                    <textarea id="pizarra" class="pizarra" placeholder="Escribe libremente..."></textarea>
                </div>

                <!-- Archivo adjunto (si existe) -->
                <% if (tema.archivo) { %>
                    <div class="mb-4">
                        <h5><i class="fas fa-paperclip me-2"></i>Material de apoyo</h5>
                        <a href="/uploads/<%= tema.archivo %>" target="_blank" class="btn btn-rosa">
                            <i class="fas fa-download me-1"></i>Ver archivo
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <script>
        // Variables
        let segundos = 0;
        let intervalo;
        const temaId = <%= tema.id %>;
        const contadorEl = document.getElementById('contador');
        const pizarraEl = document.getElementById('pizarra');
        const btnGuardar = document.getElementById('btn-guardar');

        // Cargar contenido previo si existe
        if ('<%= tema.notas %>' !== 'null') {
            pizarraEl.value = `<%= tema.notas.replace(/\n/g, '\\n').replace(/"/g, '\\"') %>`;
        }

        // Iniciar temporizador
        function iniciarTemporizador() {
            intervalo = setInterval(() => {
                segundos++;
                const mins = Math.floor(segundos / 60).toString().padStart(2, '0');
                const segs = (segundos % 60).toString().padStart(2, '0');
                contadorEl.textContent = `${mins}:${segs}`;
            }, 1000);
        }

        // Guardar progreso
        async function guardarProgreso() {
            const tiempoMinutos = Math.floor(segundos / 60);
            const notas = pizarraEl.value;

            try {
                const res = await fetch(`/temas/guardar/${temaId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tiempoMinutos, notas })
                });

                if (res.ok) {
                    alert(' ¡Progreso guardado!');
                } else {
                    alert(' Error al guardar');
                }
            } catch (err) {
                console.error(err);
                alert(' Error de conexión');
            }
        }

        // Eventos
        btnGuardar.addEventListener('click', guardarProgreso);

        // Guardar al cerrar la pestaña (opcional)
        window.addEventListener('beforeunload', (e) => {
            guardarProgreso();
            e.preventDefault();
            e.returnValue = '';
        });

        // Iniciar
        document.addEventListener('DOMContentLoaded', iniciarTemporizador);
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>